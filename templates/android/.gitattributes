# Normalize line endings in the repo; check out native endings per OS.
* text=auto

# Shell scripts must stay LF or they break on macOS, Linux and CI,
# even after being edited on Windows.
gradlew   text eol=lf
*.sh      text eol=lf

# Windows scripts stay CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files are never touched.
*.jar      binary
*.png      binary
*.webp     binary
*.jks      binary
*.keystore binary
